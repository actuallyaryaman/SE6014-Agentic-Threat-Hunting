# C3 (evidence verification and report) settings.
# Copy the lines you need into the root .env file. Never commit .env.
# This file holds names only. Every value is optional, and offline mode (the default) needs none of them.

# Direct Elasticsearch verification (cli report --verify es)
ES_URL=http://localhost:9200
ES_API_KEY=
ES_USERNAME=
ES_PASSWORD=
ES_CA_CERT=
ES_VERIFY_TLS=true
ES_TIMEOUT=10

# Verification through MCP (cli report --verify mcp)
C3_MCP_COMMAND=python
C3_MCP_ARGS=-m dev.es_mcp_standin.server
C3_MCP_CWD=
C3_MCP_ANALYTICS_COMMAND=python
C3_MCP_ANALYTICS_ARGS=

# Confidence policy: 1 follows INTERFACES section 4.3, 2 also needs events from two log sources
C3_MIN_LOG_SOURCES=1