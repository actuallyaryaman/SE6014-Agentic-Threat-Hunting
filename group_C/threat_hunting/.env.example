# Copy to .env (git-ignored). Names only; never commit real values.
# --- ES MCP server (C1's, or dev/es_mcp_standin until then); the agent itself never reads these
ES_URL=https://localhost:9200
ES_API_KEY=
ES_CA_CERT=                       # path to the cluster CA (team stack uses TLS)
# --- what the agent hunts over (Group B CONTRACTS.md section 6)
HUNT_INDEX=security-events-*
# --- MCP servers (swap in C1's server here)
HUNT_ES_MCP_CMD=python -m dev.es_mcp_standin.server
HUNT_ANALYTICS_MCP_CMD=python -m analytics_server.server
# --- optional LLM for the planner (rules are used without it); see threat_hunting/llm.py
LLM_PROVIDER=anthropic
LLM_API_KEY=
HUNT_MODEL=
# HUNT_FORCE_RULES=1
