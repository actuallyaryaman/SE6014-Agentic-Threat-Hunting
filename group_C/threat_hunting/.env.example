# Copy to .env (git-ignored). Names only; never commit real values.
# --- ES connection settings passed to the configured ES MCP subprocess
ES_URL=https://localhost:9200
ES_API_KEY=
# Path to the cluster CA (team stack uses TLS); empty uses the default trust store.
ES_CA_CERT=
# --- what the agent hunts over (Group B CONTRACTS.md section 6)
HUNT_INDEX=security-events-*
# --- MCP servers: C1's Elasticsearch server (the default) and C2's analytics server
HUNT_ES_MCP_CMD=python -m es_mcp_server.server
# Fallback with the same tools: the dev stand-in C1's server was promoted from
# HUNT_ES_MCP_CMD=python -m dev.es_mcp_standin.server
HUNT_ANALYTICS_MCP_CMD=python -m analytics_server.server
# --- LLM for the agent roles (intake, investigator, skeptic, responder, classifier, queue, chat); rules are used without it.
# Anthropic, or any OpenAI-compatible API; see threat_hunting/llm.py. Example for DeepSeek:
#   LLM_PROVIDER=openai  LLM_BASE_URL=https://api.deepseek.com  HUNT_MODEL=deepseek-flash
LLM_PROVIDER=anthropic
LLM_BASE_URL=
LLM_API_KEY=
HUNT_MODEL=
# LLM_MODEL_SKEPTIC=          per-role model override (LLM_MODEL_<ROLE>)
# LLM_JSON_MODE=1             ask an OpenAI-compatible server for a JSON object
# HUNT_FORCE_RULES=1          no LLM at all (the tests set this)
# --- agent limits
# HUNT_AGENT_MAX_STEPS=10  HUNT_LLM_MAX_CALLS=40  HUNT_DEFAULT_LOOKBACK_H=24
