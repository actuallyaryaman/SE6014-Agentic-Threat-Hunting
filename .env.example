ELASTICSEARCH_URL=https://replace-with-your-elasticsearch-ip:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=replace_with_your_password
KIBANA_SERVICE_ACCOUNT_TOKEN=replace_with_your_token

# C3 (evidence verification and report) settings. Optional: offline mode needs none of them.
# Never commit a real .env. This file holds names only.

# Direct Elasticsearch verification (cli report --verify es)
ES_URL=http://localhost:9200
ES_API_KEY=
ES_USERNAME=
ES_PASSWORD=
ES_CA_CERT=
ES_VERIFY_TLS=true
ES_TIMEOUT=10

# Verification through MCP (cli report --verify mcp)
C3_MCP_COMMAND=python
C3_MCP_ARGS=-m dev.es_mcp_standin.server
C3_MCP_CWD=
C3_MCP_ANALYTICS_COMMAND=python
C3_MCP_ANALYTICS_ARGS=

# Confidence policy: 1 follows INTERFACES section 4.3, 2 also needs events from two log sources
C3_MIN_LOG_SOURCES=1