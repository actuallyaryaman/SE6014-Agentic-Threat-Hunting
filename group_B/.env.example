# Group B environment variables.
# Copy to group_B/.env and fill in local values. Never commit the real file.

# OpenAI-compatible LLM endpoint used by B2 generation and the B3 planner.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=replace-with-pinned-model
LLM_API_KEY=replace-with-key
LLM_TEMPERATURE=0.0
LLM_SEED=42
LLM_TIMEOUT_SECONDS=60

# Elasticsearch. Use separate least-privilege keys:
# - read key: B3 verification and bounded queries
# - write key: B2 pipeline registration and explicit direct-ES fallback
ES_URL=https://localhost:9200
ES_READ_API_KEY=replace-with-read-key
ES_WRITE_API_KEY=replace-with-write-key
ES_CA_CERT=/absolute/path/to/elasticsearch/config/certs/http_ca.crt
ES_VERIFY_CERTS=true

# Read pattern and write prefix are deliberately separate. The write index is
# <prefix>-YYYY.MM.dd; never use a wildcard as a write target.
ES_SEARCH_INDEX_PATTERN=security-events-*
ES_WRITE_INDEX_PREFIX=security-events

# Group A ingestion endpoints. Use absolute paths so the working directory
# does not change where B3 looks for files.
A2_PUSH_URL=http://127.0.0.1:8088
A2_INCOMING_DIR=/absolute/path/to/smtd-proj/group_A/a2/incoming
A3_UDP_HOST=127.0.0.1
A3_UDP_PORT=9999

# B3 source allowlists. Keep these narrow.
B3_ALLOWED_ROOTS=/absolute/path/to/approved/logs
B3_ALLOWED_HOSTS=127.0.0.1,localhost
