{
  "description": "B1 firewall syslog (Allowed/Blocked connection) -> ECS",
  "processors": [
    {
      "set": {
        "field": "event.original",
        "copy_from": "message"
      }
    },
    {
      "grok": {
        "field": "message",
        "patterns": [
          "%{SYSLOGTIMESTAMP:tmp.ts} %{SYSLOGHOST:host.name} firewall: %{WORD:tmp.action} connection from %{IP:source.ip} to %{IP:destination.ip}"
        ]
      }
    },
    {
      "set": {
        "if": "ctx.labels?.log_year != null && ctx.labels.log_year.toString().length() == 4 && ctx.tmp?.ts != null && ctx.tmp.ts.length() > 0 && !Character.isDigit(ctx.tmp.ts.charAt(0))",
        "field": "tmp.ts",
        "value": "{{labels.log_year}} {{tmp.ts}}"
      }
    },
    {
      "date": {
        "field": "tmp.ts",
        "target_field": "@timestamp",
        "timezone": "UTC",
        "formats": [
          "MMM d HH:mm:ss",
          "MMM  d HH:mm:ss",
          "MMM dd HH:mm:ss",
          "yyyy MMM d HH:mm:ss",
          "yyyy MMM  d HH:mm:ss",
          "yyyy MMM dd HH:mm:ss"
        ]
      }
    },
    {
      "lowercase": {
        "field": "tmp.action",
        "target_field": "event.action"
      }
    },
    {
      "set": {
        "field": "event.category",
        "value": [
          "network"
        ]
      }
    },
    {
      "set": {
        "if": "ctx.tmp.action == 'Blocked'",
        "field": "event.type",
        "value": [
          "connection",
          "denied"
        ]
      }
    },
    {
      "set": {
        "if": "ctx.tmp.action == 'Allowed'",
        "field": "event.type",
        "value": [
          "connection",
          "allowed"
        ]
      }
    },
    {
      "set": {
        "field": "event.dataset",
        "value": "firewall"
      }
    },
    {
      "remove": {
        "field": "tmp",
        "ignore_missing": true
      }
    }
  ],
  "on_failure": [
    {
      "set": {
        "field": "message",
        "value": "(no message)",
        "if": "ctx.message == null"
      }
    },
    {
      "set": {
        "field": "event.original",
        "copy_from": "message",
        "if": "ctx.event?.original == null"
      }
    },
    {
      "set": {
        "field": "@timestamp",
        "value": "{{{_ingest.timestamp}}}",
        "if": "ctx['@timestamp'] == null"
      }
    },
    {
      "set": {
        "field": "event.dataset",
        "value": "firewall",
        "if": "ctx.event?.dataset == null"
      }
    },
    {
      "append": {
        "field": "tags",
        "value": [
          "_parse_failure"
        ],
        "allow_duplicates": false
      }
    },
    {
      "set": {
        "field": "error.message",
        "value": "{{{_ingest.on_failure_message}}}"
      }
    },
    {
      "remove": {
        "field": "tmp",
        "ignore_missing": true
      }
    }
  ]
}